# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio / Cloudflare Pages injects this at runtime from your Secret Vault.
# Never commit real API keys or signing keys to this public repository.
GEMINI_API_KEY=""

# APP_URL: The runtime URL where the web app is hosted.
APP_URL=""

# Optional Server-Side Vault Key (Set ONLY in Cloudflare Secret Vault if needed)
MILITARY_GRADE_KEY_AES256_GCM=""
OMARVIO_VAULT_SIGNATURE=""

# Optional Open-Source GitHub Release Direct APK URL
OMARVIO_APK_URL=""
OMARVIO_GITHUB_REPO="omarvio-live/omarviobrowser"
