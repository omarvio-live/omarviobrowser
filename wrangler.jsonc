{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omarvio-browser",
  "compatibility_date": "2025-02-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "dist",

  // ---------------------------------------------------------------------------
  // CLOUDFLARE PAGES EDGE RUNTIME & KV NAMESPACE BINDING
  // ---------------------------------------------------------------------------
  "kv_namespaces": [
    {
      "binding": "KV_BINDING",
      "id": "5420d1a3d14a4590ab571565c0337167",
      "preview_id": "5c100dd91d144dca82dd616e1a58613f"
    },
    {
      "binding": "OMARVIO_KV",
      "id": "5420d1a3d14a4590ab571565c0337167",
      "preview_id": "5c100dd91d144dca82dd616e1a58613f"
    },
    {
      "binding": "KV",
      "id": "5420d1a3d14a4590ab571565c0337167",
      "preview_id": "5c100dd91d144dca82dd616e1a58613f"
    }
  ],

  // Public Non-Secret Runtime Variables (Store GEMINI_API_KEY & private keys ONLY in Cloudflare Secret Vault)
  "vars": {
    "APP_NAME": "OMARVIO BROWSER",
    "APP_VERSION": "v2.0.0",
    "SLOGAN": "My Phone, My Data – Why Surrender It To Others!",
    "DEFAULT_SEARCH_ENGINE": "google",
    "ENCRYPTION_STANDARD": "AES-GCM-256-PBKDF2-100K",
    "CLOUDFLARE_EDGE_SYNC": "enabled",
    "NODE_ENV": "production",
    "ALLOW_FRAME_BYPASS": "true",
    "OMARVIO_GITHUB_REPO": "omarvio-live/omarviobrowser",
    "OMARVIO_APK_URL": "https://github.com/omarvio-live/omarviobrowser/releases/latest/download/omarvio-browser.apk"
  }
}
